# Copy this file to .env.<environment>.local (e.g. .env.development.local)
# and fill in real values. Never commit the filled-in file.

# PORT
PORT=3000

# NODE ENV — development | staging | production
NODE_ENV=development

# BASE PATH
BASE_PATH=/api/v1

# DATABASE CONNECTION
DATABASE_URL=postgresql://user:password@host:port/database

# SALT ROUNDS
SALT_ROUNDS=10

# JWT
JWT_SECRET=change-me
JWT_REFRESH_TOKEN=change-me

# CLIENT (CORS) — origin of the frontend allowed to call this API
CLIENT_URL=http://localhost:5173
